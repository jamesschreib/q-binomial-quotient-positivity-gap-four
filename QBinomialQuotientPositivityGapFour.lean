/-- The scaled two-generator Frobenius estimate in exactly the form needed
for a four-term interval. If `M` is a multiple of `gcd x y`, lies no more
than three below `lcm x y`, and `x + y > 3`, then `M` is generated by
`x` and `y`. -/
theorem pair_frobenius_from_lcm
    {x y M : ℕ} (hx : 0 < x) (hy : 0 < y)
    (hdiv : x.gcd y ∣ M) (hnear : x.lcm y ≤ M + 3)
    (hxy : 3 < x + y) :
    TwoGenerated x y M := by
  let g := x.gcd y
  let u := x / g
  let v := y / g
  let m := M / g
  have hg : 0 < g := by
    dsimp [g]
    exact Nat.gcd_pos_of_pos_left y hx
  have hgx : g * u = x := by
    dsimp [g, u]
    exact Nat.mul_div_cancel' (Nat.gcd_dvd_left x y)
  have hgy : g * v = y := by
    dsimp [g, v]
    exact Nat.mul_div_cancel' (Nat.gcd_dvd_right x y)
  have hgM : g * m = M := by
    dsimp [g, m]
    exact Nat.mul_div_cancel' hdiv
  by_cases hu : u = 1
  · refine ⟨m, 0, ?_⟩
    rw [← hgM, ← hgx, hu]
    ring
  by_cases hv : v = 1
  · refine ⟨0, m, ?_⟩
    rw [← hgM, ← hgy, hv]
    ring
  have hu2 : 2 ≤ u := by
    have hu0 : u ≠ 0 := by
      intro hu0
      rw [hu0, mul_zero] at hgx
      omega
    exact (Nat.two_le_iff u).2 ⟨hu0, hu⟩
  have hv2 : 2 ≤ v := by
    have hv0 : v ≠ 0 := by
      intro hv0
      rw [hv0, mul_zero] at hgy
      omega
    exact (Nat.two_le_iff v).2 ⟨hv0, hv⟩
  have huv : u + v ≤ u * v := by nlinarith
  have hFadd : u * v - u - v + (u + v) = u * v := by omega
  have hlcm : x.lcm y = g * (u * v) := by
    apply Nat.mul_left_cancel hg
    calc
      g * x.lcm y = x * y := Nat.gcd_mul_lcm x y
      _ = g * (g * (u * v)) := by rw [← hgx, ← hgy]; ring
  have hscaled :
      g * (u * v - u - v) + (x + y) = x.lcm y := by
    rw [hlcm, ← hgx, ← hgy]
    calc
      g * (u * v - u - v) + (g * u + g * v) =
          g * ((u * v - u - v) + (u + v)) := by ring
      _ = g * (u * v) := by rw [hFadd]
  have hscaled_lt : g * (u * v - u - v) < M := by omega
  have hnorm : u * v - u - v < m := by
    apply (Nat.mul_lt_mul_left hg).mp
    rw [hgM]
    exact hscaled_lt
  have hcop : u.Coprime v := by
    dsimp [u, v, g]
    exact Nat.coprime_div_gcd_div_gcd
      (Nat.gcd_pos_of_pos_left y hx)
  obtain ⟨r, s, hrs⟩ :=
    coprime_frobenius_bound hcop (by omega) (by omega) hnorm
  refine ⟨r, s, ?_⟩
  rw [← hgM, ← hgx, ← hgy, hrs]
  ring

lemma mem_representedIndices {a b : ℕ} {J : Finset Index} {i : Index} :
    i ∈ representedIndices a b J ↔ Represented a b J i := by
  classical
  simp [representedIndices]

lemma twoGenerated_mem_semigroup
    {b n : ℕ} {J : Finset Index} {j k : Index}
    (hj : j ∈ J) (hk : k ∈ J)
    (hgen : TwoGenerated (weight b j) (weight b k) n) :
    n ∈ weightSemigroup b J := by
  obtain ⟨r, s, rfl⟩ := hgen
  have hj' := weight_mem_semigroup (b := b) hj
  have hk' := weight_mem_semigroup (b := b) hk
  simpa [nsmul_eq_mul, Nat.mul_comm] using
    (weightSemigroup b J).add_mem
      ((weightSemigroup b J).nsmul_mem hj' r)
      ((weightSemigroup b J).nsmul_mem hk' s)

lemma threeGenerated_mem_semigroup
    {b n : ℕ} {J : Finset Index} {j k l : Index}
    (hj : j ∈ J) (hk : k ∈ J) (hl : l ∈ J)
    (hgen : ThreeGenerated (weight b j) (weight b k) (weight b l) n) :
    n ∈ weightSemigroup b J := by
  obtain ⟨r, s, t, rfl⟩ := hgen
  have hj' := weight_mem_semigroup (b := b) hj
  have hk' := weight_mem_semigroup (b := b) hk
  have hl' := weight_mem_semigroup (b := b) hl
  simpa [nsmul_eq_mul, Nat.mul_comm] using
    (weightSemigroup b J).add_mem
      ((weightSemigroup b J).add_mem
        ((weightSemigroup b J).nsmul_mem hj' r)
        ((weightSemigroup b J).nsmul_mem hk' s))
      ((weightSemigroup b J).nsmul_mem hl' t)

lemma singleton_index_covered
    {a b : ℕ} (hb : 1 ≤ b) (hcyclo : CyclotomicCondition a b)
    (j : Index) :
    ∃ i : Index, weight b j ∣ degree a i := by
  obtain ⟨i, hi, hdiv⟩ :=
    singleton_weight_is_covered hb j.isLt hcyclo
  exact ⟨⟨i, hi⟩, by simpa [weight, degree] using hdiv⟩

/-- Section 3's complete pair argument. For any two distinct denominator
weights, two distinct numerator degrees lie in their generated semigroup. -/
theorem pair_degrees_are_generated
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hcyclo : CyclotomicCondition a b)
    (j k : Index) (hjk : j ≠ k) :
    ∃ r s : Index, r ≠ s ∧
      TwoGenerated (weight b j) (weight b k) (degree a r) ∧
      TwoGenerated (weight b j) (weight b k) (degree a s) := by
  let x := weight b j
  let y := weight b k
  have hx : 0 < x := by dsimp [x, weight]; omega
  have hy : 0 < y := by dsimp [y, weight]; omega
  have hval : (j : ℕ) ≠ (k : ℕ) := by
    intro h
    exact hjk (Fin.ext h)
  have hxyne : x ≠ y := by
    dsimp [x, y, weight]
    omega
  obtain ⟨ix, hix⟩ := singleton_index_covered hb hcyclo j
  obtain ⟨iy, hiy⟩ := singleton_index_covered hb hcyclo k
  by_cases hindices : ix = iy
  · subst iy
    let N := degree a ix
    let g := x.gcd y
    have hgN : g ∣ N :=
      dvd_trans (Nat.gcd_dvd_left x y) hix
    have hNx : x ∣ N := hix
    have hNy : y ∣ N := hiy
    have hNpos : 0 < N := by dsimp [N, degree]; omega
    have hlcmN : x.lcm y ≤ N :=
      Nat.le_of_dvd hNpos (Nat.lcm_dvd hNx hNy)
    have htwo :
        ∃ r s : Index, r ≠ s ∧
          g ∣ degree a r ∧ g ∣ degree a s := by
      by_cases hg1 : g = 1
      · exact ⟨⟨0, by decide⟩, ⟨1, by decide⟩, by decide,
          by simp [hg1], by simp [hg1]⟩
      · have hg2 : 2 ≤ g := by
          have hg0 : g ≠ 0 := by
            dsimp [g]
            exact Nat.gcd_ne_zero_left hx.ne'
          exact (Nat.two_le_iff g).2 ⟨hg0, hg1⟩
        have hden : 1 < multiplicity b g := by
          rw [multiplicity, Finset.one_lt_card]
          refine ⟨j, ?_, k, ?_, hval⟩
          · exact Finset.mem_filter.mpr
              ⟨Finset.mem_range.mpr j.isLt,
                by simpa [g, x, weight] using Nat.gcd_dvd_left x y⟩
          · exact Finset.mem_filter.mpr
              ⟨Finset.mem_range.mpr k.isLt,
                by simpa [g, y, weight] using Nat.gcd_dvd_right x y⟩
        have hnum : 1 < multiplicity a g :=
          lt_of_lt_of_le hden (hcyclo g hg2)
        rw [multiplicity, Finset.one_lt_card] at hnum
        obtain ⟨r, hr, s, hs, hrs⟩ := hnum
        exact ⟨⟨r, (Finset.mem_filter.mp hr).1 |> Finset.mem_range.mp⟩,
          ⟨s, (Finset.mem_filter.mp hs).1 |> Finset.mem_range.mp⟩,
          by intro h; apply hrs; exact congrArg Fin.val h,
          (Finset.mem_filter.mp hr).2,
          (Finset.mem_filter.mp hs).2⟩
    obtain ⟨r, s, hrs, hgr, hgs⟩ := htwo
    have generate_of_gcd :
        ∀ t : Index, g ∣ degree a t →
          TwoGenerated x y (degree a t) := by
      intro t hgt
      by_cases hx1 : x = 1
      · exact ⟨degree a t, 0, by simp [hx1]⟩
      by_cases hy1 : y = 1
      · exact ⟨0, degree a t, by simp [hy1]⟩
      have hsum : 3 < x + y := by omega
      apply pair_frobenius_from_lcm hx hy
      · exact hgt
      · dsimp [N, degree] at hlcmN ⊢
        omega
      · exact hsum
    exact ⟨r, s, hrs, generate_of_gcd r hgr, generate_of_gcd s hgs⟩
  · refine ⟨ix, iy, hindices, ?_, ?_⟩
    · obtain ⟨c, hc⟩ := hix
      exact ⟨c, 0, by simpa [Nat.mul_comm] using hc⟩
    · obtain ⟨c, hc⟩ := hiy
      exact ⟨0, c, by simpa [Nat.mul_comm] using hc⟩

theorem hall_singleton
    {a b : ℕ} (hb : 1 ≤ b) (hcyclo : CyclotomicCondition a b)
    {J : Finset Index} (hJ : J.card = 1) :
    J.card ≤ (representedIndices a b J).card := by
  obtain ⟨j, rfl⟩ := Finset.card_eq_one.mp hJ
  obtain ⟨i, hdiv⟩ := singleton_index_covered hb hcyclo j
  have hmem : i ∈ representedIndices a b {j} := by
    rw [mem_representedIndices]
    exact multiple_weight_mem_semigroup (by simp) hdiv
  rw [Finset.card_singleton]
  exact Finset.card_pos.mpr ⟨i, hmem⟩

theorem hall_pair
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hcyclo : CyclotomicCondition a b)
    {J : Finset Index} (hJ : J.card = 2) :
    J.card ≤ (representedIndices a b J).card := by
  obtain ⟨j, k, hjk, rfl⟩ := Finset.card_eq_two.mp hJ
  obtain ⟨r, s, hrs, hgr, hgs⟩ :=
    pair_degrees_are_generated ha hb hcyclo j k hjk
  have hr : r ∈ representedIndices a b {j, k} := by
    rw [mem_representedIndices]
    exact twoGenerated_mem_semigroup (by simp) (by simp) hgr
  have hs : s ∈ representedIndices a b {j, k} := by
    rw [mem_representedIndices]
    exact twoGenerated_mem_semigroup (by simp) (by simp) hgs
  rw [Finset.card_insert_of_notMem (by simp [hjk]),
    Finset.card_singleton]
  exact Finset.one_lt_card.mpr ⟨r, hr, s, hs, hrs⟩

/-- A division-algorithm proof of the Frobenius bound for two consecutive
generators.  The hypothesis is the subtraction-free form
`u^2 - u ≤ n`. -/
theorem consecutive_frobenius
    {u n : ℕ} (hu : 1 ≤ u) (hbound : u * u ≤ n + u) :
    TwoGenerated u (u + 1) n := by
  let q := n / u
  let r := n % u
  have hr : r < u := Nat.mod_lt n (by omega)
  have hdecomp : r + q * u = n := by
    simpa [q, r, Nat.mul_comm] using (Nat.mod_add_div n u)
  have hq : u ≤ q + 1 := by
    by_contra h
    have hqu : q + 2 ≤ u := by omega
    have hmul : (q + 2) * u ≤ u * u :=
      Nat.mul_le_mul_right u hqu
    nlinarith only [hbound, hdecomp, hr, hmul]
  have hrq : r ≤ q := by omega
  refine ⟨q - r, r, ?_⟩
  calc
    n = r + q * u := hdecomp.symm
    _ = (q - r) * u + r * (u + 1) := by
      have hsub : q - r + r = q := Nat.sub_add_cancel hrq
      nlinarith only [hsub]

/-- Every integer at or above `T - 1`, where `T = b(b+3)`, is generated by
`b` and `b+1`. -/
theorem generated_by_b_b_add_one
    {b n : ℕ} (hb : 1 ≤ b) (hn : b * (b + 3) - 1 ≤ n) :
    TwoGenerated b (b + 1) n := by
  apply consecutive_frobenius hb
  have hT : 1 ≤ b * (b + 3) := by
    have : 0 < b * (b + 3) := Nat.mul_pos (by omega) (by omega)
    omega
  have hn' : b * (b + 3) ≤ n + 1 := by omega
  nlinarith only [hn']

/-- Every integer at or above `T - 1` is also generated by `b+1` and
`b+2`. -/
theorem generated_by_b_add_one_b_add_two
    {b n : ℕ} (hb : 1 ≤ b) (hn : b * (b + 3) - 1 ≤ n) :
    TwoGenerated (b + 1) (b + 2) n := by
  apply consecutive_frobenius (u := b + 1) (by omega)
  have hT : 1 ≤ b * (b + 3) := by
    have : 0 < b * (b + 3) := Nat.mul_pos (by omega) (by omega)
    omega
  have hn' : b * (b + 3) ≤ n + 1 := by omega
  nlinarith only [hn']

/-- Membership in the semigroup generated by the exceptional triple
`b, b + 2, b + 3`. -/
def ExceptionalTripleGenerated (b n : ℕ) : Prop :=
  ∃ r s t : ℕ, n = r * b + s * (b + 2) + t * (b + 3)

/-- Formal check of the three exceptional identities, followed by the
consecutive-generator Frobenius bound. -/
theorem exceptional_triple_conductor
    {b n : ℕ} (hb : 5 ≤ b) (hn : b * (b + 3) - 1 ≤ n) :
    ExceptionalTripleGenerated b n := by
  let T := b * (b + 3)
  have hTpos : 1 ≤ T := by
    dsimp [T]
    have : 0 < b * (b + 3) := Nat.mul_pos (by omega) (by omega)
    omega
  have hnT : T ≤ n + 1 := by
    dsimp [T] at hTpos ⊢
    omega
  rcases (by omega : n = T - 1 ∨ n = T ∨ n = T + 1 ∨ T + 2 ≤ n) with
      h | h | h | h
  · refine ⟨0, 1, b - 1, ?_⟩
    rw [h]
    dsimp [T]
    have hsub : b - 1 + 1 = b := Nat.sub_add_cancel (by omega)
    have heq :
        0 * b + 1 * (b + 2) + (b - 1) * (b + 3) + 1 =
          b * (b + 3) := by
      nlinarith only [hsub]
    omega
  · refine ⟨0, 0, b, ?_⟩
    rw [h]
    dsimp [T]
    ring
  · refine ⟨1, b - 1, 1, ?_⟩
    rw [h]
    dsimp [T]
    have hsub : b - 1 + 1 = b := Nat.sub_add_cancel (by omega)
    nlinarith only [hsub]
  · obtain ⟨r, s, hrs⟩ :=
      consecutive_frobenius (u := b + 2) (n := n) (by omega) (by
        dsimp [T] at h
        nlinarith only [h])
    exact ⟨0, r, s, by simpa using hrs⟩

lemma exceptionalTriple_to_threeGenerated
    {b n : ℕ} (h : ExceptionalTripleGenerated b n) :
    ThreeGenerated (weight b ⟨0, by decide⟩)
      (weight b ⟨2, by decide⟩) (weight b ⟨3, by decide⟩) n := by
  obtain ⟨r, s, t, h⟩ := h
  exact ⟨r, s, t, by simpa [weight] using h⟩

/-- Section 5: above the gap threshold, every numerator degree belongs to
every three-weight semigroup. -/
theorem hall_triple_large
    {a b : ℕ} (hb : 5 ≤ b) (ha : b * (b + 3) - 1 ≤ a)
    {J : Finset Index} (hJ : J.card = 3) :
    J.card ≤ (representedIndices a b J).card := by
  have hcomp : Jᶜ.card = 1 := by
    rw [Finset.card_compl, Fintype.card_fin, hJ]
  obtain ⟨m, hm⟩ := Finset.card_eq_one.mp hcomp
  have mem_of_ne (q : Index) (hqm : q ≠ m) : q ∈ J := by
    by_contra hq
    have hqc : q ∈ Jᶜ := Finset.mem_compl.mpr hq
    rw [hm] at hqc
    exact hqm (Finset.mem_singleton.mp hqc)
  have hall : ∀ i : Index, i ∈ representedIndices a b J := by
    intro i
    rw [mem_representedIndices]
    have hdegree : b * (b + 3) - 1 ≤ degree a i := by
      dsimp [degree]
      omega
    fin_cases m
    · apply twoGenerated_mem_semigroup
        (mem_of_ne ⟨1, by decide⟩ (by decide))
        (mem_of_ne ⟨2, by decide⟩ (by decide))
      simpa [weight] using
        (generated_by_b_add_one_b_add_two (b := b) (n := degree a i)
          (by omega) hdegree)
    · exact threeGenerated_mem_semigroup
        (mem_of_ne ⟨0, by decide⟩ (by decide))
        (mem_of_ne ⟨2, by decide⟩ (by decide))
        (mem_of_ne ⟨3, by decide⟩ (by decide))
        (exceptionalTriple_to_threeGenerated
          (exceptional_triple_conductor hb hdegree))
    · apply twoGenerated_mem_semigroup
        (mem_of_ne ⟨0, by decide⟩ (by decide))
        (mem_of_ne ⟨1, by decide⟩ (by decide))
      simpa [weight] using
        (generated_by_b_b_add_one (b := b) (n := degree a i)
          (by omega) hdegree)
    · apply twoGenerated_mem_semigroup
        (mem_of_ne ⟨0, by decide⟩ (by decide))
        (mem_of_ne ⟨1, by decide⟩ (by decide))
      simpa [weight] using
        (generated_by_b_b_add_one (b := b) (n := degree a i)
          (by omega) hdegree)
  have heq : representedIndices a b J = Finset.univ :=
    Finset.eq_univ_of_forall hall
  rw [hJ, heq, Finset.card_fin]
  omega

theorem hall_full_large
    {a b : ℕ} (hb : 5 ≤ b) (ha : b * (b + 3) - 1 ≤ a)
    {J : Finset Index} (hJ : J.card = 4) :
    J.card ≤ (representedIndices a b J).card := by
  have hJuniv : J = Finset.univ := by
    apply Finset.eq_univ_of_card
    simpa [Fintype.card_fin] using hJ
  subst J
  have hall : ∀ i : Index, i ∈ representedIndices a b Finset.univ := by
    intro i
    rw [mem_representedIndices]
    apply twoGenerated_mem_semigroup
      (j := ⟨0, by decide⟩) (k := ⟨1, by decide⟩) (by simp) (by simp)
    simpa [weight] using
      (generated_by_b_b_add_one (b := b) (n := degree a i) (by omega)
        (by dsimp [degree]; omega))
  have heq : representedIndices a b Finset.univ = Finset.univ :=
    Finset.eq_univ_of_forall hall
  rw [Finset.card_univ, Fintype.card_fin, heq,
    Finset.card_univ, Fintype.card_fin]

/-- The elementary interval check behind the last `b = 4` triple: if a
four-term block starting at `a ≥ 4` contains at least two of `4, 8, 9`,
then it contains both `8` and `9`, and its start is `6`, `7`, or `8`. -/
theorem b_four_only_dangerous_starts
    {a : ℕ} (ha : 4 ≤ a)
    (hcard :
      2 ≤ (({4, 8, 9} : Finset ℕ).filter
        (fun n ↦ a ≤ n ∧ n ≤ a + 3)).card) :
    a = 6 ∨ a = 7 ∨ a = 8 := by
  have htwo :
      1 < (({4, 8, 9} : Finset ℕ).filter
        (fun n ↦ a ≤ n ∧ n ≤ a + 3)).card := by omega
  obtain ⟨x, hx, y, hy, hxy⟩ := Finset.one_lt_card.mp htwo
  simp only [Finset.mem_filter, Finset.mem_insert, Finset.mem_singleton] at hx hy
  rcases hx.1 with rfl | rfl | rfl <;>
    rcases hy.1 with rfl | rfl | rfl <;> omega

/-- Start `a = 6` is ruled out by the `d = 5` cyclotomic inequality. -/
theorem not_cyclotomic_six_four : ¬ CyclotomicCondition 6 4 := by
  intro h
  have hc := h 5 (by norm_num)
  have hb : multiplicity 4 5 = 1 := by decide
  have ha : multiplicity 6 5 = 0 := by decide
  omega

/-- Starts `a = 7` and `a = 8` are ruled out by the `d = 6`
cyclotomic inequality. -/
theorem not_cyclotomic_seven_four : ¬ CyclotomicCondition 7 4 := by
  intro h
  have hc := h 6 (by norm_num)
  have hb : multiplicity 4 6 = 1 := by decide
  have ha : multiplicity 7 6 = 0 := by decide
  omega

theorem not_cyclotomic_eight_four : ¬ CyclotomicCondition 8 4 := by
  intro h
  have hc := h 6 (by norm_num)
  have hb : multiplicity 4 6 = 1 := by decide
  have ha : multiplicity 8 6 = 0 := by decide
  omega

/-- The `b = 3` cyclotomic count forces the numerator block to start at a
multiple of three. -/
theorem cyclotomic_three_dvd
    {a : ℕ} (hcyclo : CyclotomicCondition a 3) :
    3 ∣ a := by
  have hden : multiplicity 3 3 = 2 := by decide
  have hnum : 2 ≤ multiplicity a 3 := by
    simpa [hden] using hcyclo 3 (by omega)
  have htwo : 1 < multiplicity a 3 := by omega
  rw [multiplicity, Finset.one_lt_card] at htwo
  obtain ⟨r, hr, s, hs, hrs⟩ := htwo
  have hrlt := Finset.mem_range.mp (Finset.mem_filter.mp hr).1
  have hslt := Finset.mem_range.mp (Finset.mem_filter.mp hs).1
  have hdr := (Finset.mem_filter.mp hr).2
  have hds := (Finset.mem_filter.mp hs).2
  obtain ⟨u, hu⟩ := hdr
  obtain ⟨v, hv⟩ := hds
  have hzero : r = 0 ∨ s = 0 := by omega
  rcases hzero with rfl | rfl
  · exact ⟨u, by simpa using hu⟩
  · exact ⟨v, by simpa using hv⟩

def badIndices (a : ℕ) (G : Finset ℕ) : Finset Index :=
  Finset.univ.filter fun i ↦ degree a i ∈ G

lemma badIndices_singleton_le_one (a g : ℕ) :
    (badIndices a {g}).card ≤ 1 := by
  rw [Finset.card_le_one]
  intro i hi j hj
  simp [badIndices, degree] at hi hj
  exact Fin.ext (by omega)

lemma badIndices_pair_far_le_one
    {a g h : ℕ} (hfar : g + 3 < h ∨ h + 3 < g) :
    (badIndices a {g, h}).card ≤ 1 := by
  rw [Finset.card_le_one]
  intro i hi j hj
  simp only [badIndices, Finset.mem_filter, Finset.mem_univ, true_and,
    Finset.mem_insert, Finset.mem_singleton] at hi hj
  rcases hi with hi | hi <;> rcases hj with hj | hj
  · exact Fin.ext (by dsimp [degree] at hi hj; omega)
  · exfalso
    dsimp [degree] at hi hj
    omega
  · exfalso
    dsimp [degree] at hi hj
    omega
  · exact Fin.ext (by dsimp [degree] at hi hj; omega)

lemma badIndices_47_le_one_of_three_dvd
    {a : ℕ} (hdiv : 3 ∣ a) :
    (badIndices a {4, 7}).card ≤ 1 := by
  rw [Finset.card_le_one]
  intro i hi j hj
  obtain ⟨c, rfl⟩ := hdiv
  simp only [badIndices, Finset.mem_filter, Finset.mem_univ, true_and,
    Finset.mem_insert, Finset.mem_singleton] at hi hj
  rcases hi with hi | hi <;> rcases hj with hj | hj
  · exact Fin.ext (by dsimp [degree] at hi hj; omega)
  · exfalso
    dsimp [degree] at hi hj
    omega
  · exfalso
    dsimp [degree] at hi hj
    omega
  · exact Fin.ext (by dsimp [degree] at hi hj; omega)

lemma badIndices_489_le_one
    {a : ℕ} (ha : 4 ≤ a) (hcyclo : CyclotomicCondition a 4) :
    (badIndices a {4, 8, 9}).card ≤ 1 := by
  rw [Finset.card_le_one]
  intro i hi j hj
  by_contra hij
  have hval : (i : ℕ) ≠ (j : ℕ) := by
    intro h
    exact hij (Fin.ext h)
  simp only [badIndices, Finset.mem_filter, Finset.mem_univ, true_and,
    Finset.mem_insert, Finset.mem_singleton] at hi hj
  rcases hi with hi | hi | hi <;> rcases hj with hj | hj | hj
  all_goals
    dsimp [degree] at hi hj
  all_goals try omega
  all_goals
    have hstart : a = 6 ∨ a = 7 ∨ a = 8 := by omega
    rcases hstart with rfl | rfl | rfl
    · exact not_cyclotomic_six_four hcyclo
    · exact not_cyclotomic_seven_four hcyclo
    · exact not_cyclotomic_eight_four hcyclo

/-- If every degree outside a finite gap set is represented and a
four-term degree block meets that gap set at most once, at least three
degrees are represented. -/
theorem represented_card_ge_three_of_gaps
    {a b : ℕ} {J : Finset Index} (G : Finset ℕ)
    (hbad : (badIndices a G).card ≤ 1)
    (hrep : ∀ i : Index, degree a i ∉ G → Represented a b J i) :
    3 ≤ (representedIndices a b J).card := by
  have hsub : (representedIndices a b J)ᶜ ⊆ badIndices a G := by
    intro i hi
    rw [Finset.mem_compl] at hi
    rw [badIndices, Finset.mem_filter]
    refine ⟨Finset.mem_univ _, ?_⟩
    by_contra hgap
    exact hi (mem_representedIndices.mpr (hrep i hgap))
  have hcard := Finset.card_le_card hsub
  rw [Finset.card_compl, Fintype.card_fin] at hcard
  omega

/-- Section 6's complete three-weight check. -/
theorem hall_triple_small
    {a b : ℕ} (hb : 1 ≤ b) (hb4 : b ≤ 4) (ha : b ≤ a)
    (hcyclo : CyclotomicCondition a b)
    {J : Finset Index} (hJ : J.card = 3) :
    J.card ≤ (representedIndices a b J).card := by
  have hcomp : Jᶜ.card = 1 := by
    rw [Finset.card_compl, Fintype.card_fin, hJ]
  obtain ⟨m, hm⟩ := Finset.card_eq_one.mp hcomp
  have mem_of_ne (q : Index) (hqm : q ≠ m) : q ∈ J := by
    by_contra hq
    have hqc : q ∈ Jᶜ := Finset.mem_compl.mpr hq
    rw [hm] at hqc
    exact hqm (Finset.mem_singleton.mp hqc)
  have finish (G : Finset ℕ)
      (hbad : (badIndices a G).card ≤ 1)
      (hgen : ∀ i : Index, degree a i ∉ G →
        degree a i ∈ weightSemigroup b J) :
      J.card ≤ (representedIndices a b J).card := by
    rw [hJ]
    exact represented_card_ge_three_of_gaps G hbad hgen
  interval_cases b <;> fin_cases m
  · -- b=1, J={1,2,3}, weights 2,3,4
    apply finish {1} (badIndices_singleton_le_one a 1)
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨1, by decide⟩ (by decide))
      (mem_of_ne ⟨2, by decide⟩ (by decide))
      (mem_of_ne ⟨3, by decide⟩ (by decide))
    simpa [weight] using generated_234 (n := degree a i) (by
      simp only [Finset.mem_singleton] at hi
      dsimp [degree] at hi ⊢
      omega)
  · -- b=1, the remaining triples contain weight 1
    apply finish ∅ (by simp [badIndices])
    intro i hi
    exact multiple_weight_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide)) (by simp [weight])
  · apply finish ∅ (by simp [badIndices])
    intro i hi
    exact multiple_weight_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide)) (by simp [weight])
  · apply finish ∅ (by simp [badIndices])
    intro i hi
    exact multiple_weight_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide)) (by simp [weight])
  · -- b=2, J={1,2,3}, weights 3,4,5; only gap 2
    apply finish {2} (badIndices_singleton_le_one a 2)
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨1, by decide⟩ (by decide))
      (mem_of_ne ⟨2, by decide⟩ (by decide))
      (mem_of_ne ⟨3, by decide⟩ (by decide))
    simpa [weight] using generated_345 (n := degree a i) (by
      simp only [Finset.mem_singleton] at hi
      dsimp [degree] at hi ⊢
      omega)
  · -- weights 2,4,5; only gap 3
    apply finish {3} (badIndices_singleton_le_one a 3)
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide))
      (mem_of_ne ⟨2, by decide⟩ (by decide))
      (mem_of_ne ⟨3, by decide⟩ (by decide))
    simpa [weight] using generated_245 (n := degree a i) (by
      dsimp [degree]; omega) (by simpa using hi)
  · -- weights 2,3,5
    apply finish ∅ (by simp [badIndices])
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide))
      (mem_of_ne ⟨1, by decide⟩ (by decide))
      (mem_of_ne ⟨3, by decide⟩ (by decide))
    simpa [weight] using generated_235 (n := degree a i) (by
      dsimp [degree]; omega)
  · -- weights 2,3,4
    apply finish ∅ (by simp [badIndices])
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide))
      (mem_of_ne ⟨1, by decide⟩ (by decide))
      (mem_of_ne ⟨2, by decide⟩ (by decide))
    simpa [weight] using generated_234 (n := degree a i) (by
      dsimp [degree]; omega)
  · -- b=3, weights 4,5,6; gaps 3,7
    apply finish {3, 7} (badIndices_pair_far_le_one (by omega))
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨1, by decide⟩ (by decide))
      (mem_of_ne ⟨2, by decide⟩ (by decide))
      (mem_of_ne ⟨3, by decide⟩ (by decide))
    apply generated_456 (n := degree a i) (by dsimp [degree]; omega)
    · simpa using fun h : degree a i = 3 ↦ hi (by simp [h])
    · simpa using fun h : degree a i = 7 ↦ hi (by simp [h])
  · -- weights 3,5,6; gaps 4,7
    apply finish {4, 7} (badIndices_47_le_one_of_three_dvd
      (cyclotomic_three_dvd hcyclo))
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide))
      (mem_of_ne ⟨2, by decide⟩ (by decide))
      (mem_of_ne ⟨3, by decide⟩ (by decide))
    apply generated_356 (n := degree a i) (by dsimp [degree]; omega)
    · simpa using fun h : degree a i = 4 ↦ hi (by simp [h])
    · simpa using fun h : degree a i = 7 ↦ hi (by simp [h])
  · -- weights 3,4,6; gap 5
    apply finish {5} (badIndices_singleton_le_one a 5)
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide))
      (mem_of_ne ⟨1, by decide⟩ (by decide))
      (mem_of_ne ⟨3, by decide⟩ (by decide))
    apply generated_346 (n := degree a i) (by dsimp [degree]; omega)
    simpa using fun h : degree a i = 5 ↦ hi (by simp [h])
  · -- weights 3,4,5
    apply finish ∅ (by simp [badIndices])
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide))
      (mem_of_ne ⟨1, by decide⟩ (by decide))
      (mem_of_ne ⟨2, by decide⟩ (by decide))
    simpa [weight] using generated_345 (n := degree a i) (by
      dsimp [degree]; omega)
  · -- b=4, weights 5,6,7; gaps 4,8,9
    apply finish {4, 8, 9} (badIndices_489_le_one ha hcyclo)
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨1, by decide⟩ (by decide))
      (mem_of_ne ⟨2, by decide⟩ (by decide))
      (mem_of_ne ⟨3, by decide⟩ (by decide))
    apply generated_567 (n := degree a i) (by dsimp [degree]; omega)
    · simpa using fun h : degree a i = 4 ↦ hi (by simp [h])
    · simpa using fun h : degree a i = 8 ↦ hi (by simp [h])
    · simpa using fun h : degree a i = 9 ↦ hi (by simp [h])
  · -- weights 4,6,7; gaps 5,9
    apply finish {5, 9} (badIndices_pair_far_le_one (by omega))
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide))
      (mem_of_ne ⟨2, by decide⟩ (by decide))
      (mem_of_ne ⟨3, by decide⟩ (by decide))
    apply generated_467 (n := degree a i) (by dsimp [degree]; omega)
    · simpa using fun h : degree a i = 5 ↦ hi (by simp [h])
    · simpa using fun h : degree a i = 9 ↦ hi (by simp [h])
  · -- weights 4,5,7; gap 6
    apply finish {6} (badIndices_singleton_le_one a 6)
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide))
      (mem_of_ne ⟨1, by decide⟩ (by decide))
      (mem_of_ne ⟨3, by decide⟩ (by decide))
    apply generated_457 (n := degree a i) (by dsimp [degree]; omega)
    simpa using fun h : degree a i = 6 ↦ hi (by simp [h])
  · -- weights 4,5,6; gap 7
    apply finish {7} (badIndices_singleton_le_one a 7)
    intro i hi
    apply threeGenerated_mem_semigroup
      (mem_of_ne ⟨0, by decide⟩ (by decide))
      (mem_of_ne ⟨1, by decide⟩ (by decide))
      (mem_of_ne ⟨2, by decide⟩ (by decide))
    apply generated_456 (n := degree a i) (by dsimp [degree]; omega)
    · intro h
      dsimp [degree] at h
      omega
    · simpa using fun h : degree a i = 7 ↦ hi (by simp [h])

/-- Section 6's four-weight condition. -/
theorem hall_full_small
    {a b : ℕ} (hb : 1 ≤ b) (hb4 : b ≤ 4) (ha : b ≤ a)
    {J : Finset Index} (hJ : J.card = 4) :
    J.card ≤ (representedIndices a b J).card := by
  have hJuniv : J = Finset.univ := by
    apply Finset.eq_univ_of_card
    simpa [Fintype.card_fin] using hJ
  subst J
  have hall : ∀ i : Index, i ∈ representedIndices a b Finset.univ := by
    intro i
    rw [mem_representedIndices]
    interval_cases b
    · exact multiple_weight_mem_semigroup
        (j := ⟨0, by decide⟩) (by simp) (by simp [weight])
    · apply threeGenerated_mem_semigroup
        (j := ⟨0, by decide⟩) (k := ⟨1, by decide⟩)
        (l := ⟨2, by decide⟩) (by simp) (by simp) (by simp)
      simpa [weight] using generated_234 (n := degree a i) (by
        dsimp [degree]
        omega)
    · apply threeGenerated_mem_semigroup
        (j := ⟨0, by decide⟩) (k := ⟨1, by decide⟩)
        (l := ⟨2, by decide⟩) (by simp) (by simp) (by simp)
      simpa [weight] using generated_345 (n := degree a i) (by
        dsimp [degree]
        omega)
    · by_cases h7 : degree a i = 7
      · exact multiple_weight_mem_semigroup
          (j := ⟨3, by decide⟩) (by simp) (by simp [weight, h7])
      · apply threeGenerated_mem_semigroup
          (j := ⟨0, by decide⟩) (k := ⟨1, by decide⟩)
          (l := ⟨2, by decide⟩) (by simp) (by simp) (by simp)
        simpa [weight] using generated_456 (n := degree a i)
          (by dsimp [degree]; omega) (by dsimp [degree]; omega) h7
  have heq : representedIndices a b Finset.univ = Finset.univ :=
    Finset.eq_univ_of_forall hall
  rw [Finset.card_univ, Fintype.card_fin, heq,
    Finset.card_univ, Fintype.card_fin]

/-- The complete arithmetic conclusion of Sections 1 and 3--6: the
cyclotomic inequalities imply every semigroup cardinality condition (3). -/
theorem hallCondition_of_cyclotomic
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hcyclo : CyclotomicCondition a b) :
    HallCondition a b := by
  have hab : b ≤ a := cyclotomic_implies_a_ge_b ha hb hcyclo
  intro J hJnonempty
  by_cases heq : a = b
  · subst a
    have hsub : J ⊆ representedIndices b b J := by
      intro i hi
      rw [mem_representedIndices]
      apply multiple_weight_mem_semigroup hi
      simp [weight, degree]
    exact Finset.card_le_card hsub
  have hcardpos : 0 < J.card := Finset.card_pos.mpr hJnonempty
  have hcardle : J.card ≤ 4 := by
    calc
      J.card ≤ (Finset.univ : Finset Index).card := Finset.card_le_univ J
      _ = 4 := Finset.card_fin 4
  rcases (by omega : J.card = 1 ∨ J.card = 2 ∨ J.card = 3 ∨ J.card = 4) with
      h1 | h2 | h3 | h4
  · exact hall_singleton hb hcyclo h1
  · exact hall_pair ha hb hcyclo h2
  · by_cases hb4 : b ≤ 4
    · exact hall_triple_small hb hb4 hab hcyclo h3
    · have hb5 : 5 ≤ b := by omega
      have hlarge : b * (b + 3) - 1 ≤ a := by
        rcases gap_lemma ha hb5 hcyclo with h | h
        · exact False.elim (heq h)
        · exact h
      exact hall_triple_large hb5 hlarge h3
  · by_cases hb4 : b ≤ 4
    · exact hall_full_small hb hb4 hab h4
    · have hb5 : 5 ≤ b := by omega
      have hlarge : b * (b + 3) - 1 ≤ a := by
        rcases gap_lemma ha hb5 hcyclo with h | h
        · exact False.elim (heq h)
        · exact h
      exact hall_full_large hb5 hlarge h4

/-- End-to-end machine-checked reduction from polynomiality of the quotient
to every semigroup condition (3). -/
theorem hallCondition_of_polynomialQuotient
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hpoly : IsPolynomialQuotient a b) :
    HallCondition a b :=
  hallCondition_of_cyclotomic ha hb
    (cyclotomicCondition_of_polynomialQuotient ha hb hpoly)

/-- Direct paper-level version: divisibility of the product of four literal
`q`-integers implies every Hall condition. -/
theorem hallCondition_of_qIntegerPolynomialQuotient
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hpoly : IsQIntegerPolynomialQuotient a b) :
    HallCondition a b :=
  hallCondition_of_polynomialQuotient ha hb
    ((isQIntegerPolynomialQuotient_iff a b).mp hpoly)

/-- A direct degree check, independently confirming that polynomiality of the
literal quotient forces `b ≤ a`. -/
theorem qIntegerPolynomialQuotient_implies_b_le_a
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hpoly : IsQIntegerPolynomialQuotient a b) :
    b ≤ a := by
  have hdeg := Polynomial.natDegree_le_of_dvd hpoly
    (qIntegerProduct_ne_zero a ha)
  rw [qIntegerProduct_natDegree a ha,
    qIntegerProduct_natDegree b hb] at hdeg
  omega

/-- The one remaining algebraic interface has Aristotle's coefficientwise
`ci_positivity` conclusion, restricted to the paper's positive domain.
The guards `1 ≤ a` and `1 ≤ b` are essential: without them, the unguarded
statement fails at `a = b = 0`, where both products vanish. Under the Hall
condition, any existing quotient polynomial has nonnegative integer
coefficients. -/
def WeightedCompleteIntersectionBridge : Prop :=
  ∀ a b : ℕ, 1 ≤ a → 1 ≤ b → HallCondition a b →
    ∀ P : Polynomial ℤ,
      qIntegerProduct b * P = qIntegerProduct a →
      ∀ n, 0 ≤ P.coeff n

/-- **External theorem: weighted complete-intersection positivity.**

This is the direct combination of Propositions 3.3 and 3.6 in:

* M. Gatzweiler, F. Levicán-Santibáñez, and A. Yoshida,
  *Cyclotomic generating functions, empty weighted complete intersections
  and positivity*, arXiv:2603.22226v1 (2026),
  https://doi.org/10.48550/arXiv.2603.22226.

Proposition 3.3 identifies the semigroup-cardinality condition with existence
of a homogeneous regular sequence of the prescribed positive degrees and
weights. Proposition 3.6 proves that its Hilbert-series quotient has
nonnegative coefficients. Instantiating their multisets with
`[a, a+1, a+2, a+3]` and `[b, b+1, b+2, b+3]` gives exactly this declaration.

This named axiom is the only project-specific external assumption. Every
cyclotomic, numerical-semigroup, gap, exceptional-case, and theorem-assembly
step is proved in Lean. -/
axiom weightedCompleteIntersectionBridge_external :
  WeightedCompleteIntersectionBridge

/-- Aristotle's coefficientwise formulation, now derived without placeholders
from the explicit weighted-complete-intersection hypothesis. -/
theorem qInteger_quotient_coeff_nonnegative_of_weightedCompleteIntersection
    (hWCI : WeightedCompleteIntersectionBridge)
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (P : Polynomial ℤ)
    (hP : qIntegerProduct b * P = qIntegerProduct a) :
    ∀ n, 0 ≤ P.coeff n :=
  hWCI a b ha hb
    (hallCondition_of_qIntegerPolynomialQuotient ha hb ⟨P, hP.symm⟩)
    P hP

/-- Coefficient positivity stated directly for the paper's literal
`q`-integer quotient. The conversion from nonnegative integer coefficients
to a polynomial over `ℕ` is proved in
`coefficientwiseToNat_map_of_nonnegative`. -/
theorem qInteger_quotient_positivity_of_weightedCompleteIntersection
    (hWCI : WeightedCompleteIntersectionBridge)
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hpoly : IsQIntegerPolynomialQuotient a b) :
    HasNonnegativeQIntegerQuotient a b := by
  obtain ⟨P, hP⟩ := hpoly
  have hcoeff : ∀ n, 0 ≤ P.coeff n :=
    qInteger_quotient_coeff_nonnegative_of_weightedCompleteIntersection
      hWCI ha hb P hP.symm
  refine ⟨coefficientwiseToNat P, ?_⟩
  rw [coefficientwiseToNat_map_of_nonnegative P hcoeff]
  exact hP

/-- The exact coefficient-positivity theorem follows from the Section 2
bridge and the fully checked arithmetic reduction. This theorem has no
hidden axiom: the bridge is an explicit hypothesis. -/
theorem quotient_positivity_of_weightedCompleteIntersection
    (hWCI : WeightedCompleteIntersectionBridge)
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hpoly : IsPolynomialQuotient a b) :
    HasNonnegativeQuotient a b := by
  rw [← hasNonnegativeQIntegerQuotient_iff]
  exact qInteger_quotient_positivity_of_weightedCompleteIntersection
    hWCI ha hb ((isQIntegerPolynomialQuotient_iff a b).mpr hpoly)

/-- Index-gap-four parameters `a = n-k+1`, `b = k-3`. -/
theorem q_binomial_quotient_positivity_gap_four_of_weightedCompleteIntersection
    (hWCI : WeightedCompleteIntersectionBridge)
    {n k : ℕ} (hk : 4 ≤ k) (hkn : k ≤ n)
    (hpoly : IsPolynomialQuotient (n - k + 1) (k - 3)) :
    HasNonnegativeQuotient (n - k + 1) (k - 3) := by
  apply quotient_positivity_of_weightedCompleteIntersection hWCI
  · have hrewrite : n - k + 1 = n + 1 - k := by omega
    rw [hrewrite]
    omega
  · omega
  · exact hpoly

/-- Index-gap-four parameters, with polynomiality and positivity stated for
the literal products of `q`-integers in the conjecture. -/
theorem q_binomial_qInteger_quotient_positivity_gap_four_of_weightedCompleteIntersection
    (hWCI : WeightedCompleteIntersectionBridge)
    {n k : ℕ} (hk : 4 ≤ k) (hkn : k ≤ n)
    (hpoly :
      IsQIntegerPolynomialQuotient (n - k + 1) (k - 3)) :
    HasNonnegativeQIntegerQuotient (n - k + 1) (k - 3) := by
  apply qInteger_quotient_positivity_of_weightedCompleteIntersection hWCI
  · have hrewrite : n - k + 1 = n + 1 - k := by omega
    rw [hrewrite]
    omega
  · omega
  · exact hpoly

/-! ## Publication theorem -/

/-- Polynomiality of the normalized four-factor quotient implies
coefficientwise nonnegativity. The only external dependency is
`weightedCompleteIntersectionBridge_external`. -/
theorem quotient_positivity
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hpoly : IsPolynomialQuotient a b) :
    HasNonnegativeQuotient a b :=
  quotient_positivity_of_weightedCompleteIntersection
    weightedCompleteIntersectionBridge_external ha hb hpoly

/-- The same result for the literal product of four `q`-integers. -/
theorem qInteger_quotient_positivity
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hpoly : IsQIntegerPolynomialQuotient a b) :
    HasNonnegativeQIntegerQuotient a b :=
  qInteger_quotient_positivity_of_weightedCompleteIntersection
    weightedCompleteIntersectionBridge_external ha hb hpoly

/-- Coefficientwise positivity, discharged by the single cited external
bridge after the machine-checked Hall reduction. -/
theorem qInteger_quotient_coeff_nonnegative
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (P : Polynomial ℤ)
    (hP : qIntegerProduct b * P = qIntegerProduct a) :
    ∀ n, 0 ≤ P.coeff n :=
  qInteger_quotient_coeff_nonnegative_of_weightedCompleteIntersection
    weightedCompleteIntersectionBridge_external ha hb P hP

/-- Index-gap-four q-binomial parameters `a = n-k+1`, `b = k-3`. -/
theorem q_binomial_quotient_positivity_gap_four
    {n k : ℕ} (hk : 4 ≤ k) (hkn : k ≤ n)
    (hpoly : IsPolynomialQuotient (n - k + 1) (k - 3)) :
    HasNonnegativeQuotient (n - k + 1) (k - 3) :=
  q_binomial_quotient_positivity_gap_four_of_weightedCompleteIntersection
    weightedCompleteIntersectionBridge_external hk hkn hpoly

/-- Index-gap-four parameters for the literal `q`-integer quotient. -/
theorem q_binomial_qInteger_quotient_positivity_gap_four
    {n k : ℕ} (hk : 4 ≤ k) (hkn : k ≤ n)
    (hpoly :
      IsQIntegerPolynomialQuotient (n - k + 1) (k - 3)) :
    HasNonnegativeQIntegerQuotient (n - k + 1) (k - 3) :=
  q_binomial_qInteger_quotient_positivity_gap_four_of_weightedCompleteIntersection
    weightedCompleteIntersectionBridge_external hk hkn hpoly

end QBinomialQuotientPositivityGapFour
