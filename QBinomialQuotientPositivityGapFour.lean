import Mathlib.Data.Finset.Card
import Mathlib.Algebra.Polynomial.FieldDivision
import Mathlib.NumberTheory.FrobeniusNumber
import Mathlib.RingTheory.Polynomial.Cyclotomic.Roots
import Mathlib.Tactic

/-!
# Q-binomial quotient positivity at index gap four

Formal verification of the `l = k - 4` case of the q-binomial quotient
positivity conjecture. For `4 ≤ k ≤ n`, the quotient

`[n choose k]_q / [n choose (k - 4)]_q`

is represented by the four consecutive q-integer factors with
`a = n - k + 1` and `b = k - 3`.

This module machine-checks the exact reduction from polynomial divisibility
of the four-factor quotient to all of the finite semigroup conditions used in
in the proof. In particular, it proves the cyclotomic multiplicity criterion,
the sharp gap lemma, every large-`b` Hall case, and every small-`b` exception.

The standard weighted-complete-intersection construction is isolated as
`WeightedCompleteIntersectionBridge` and invoked once through the documented
literature axiom `weightedCompleteIntersectionBridge_external`. The final
coefficient-positivity theorems are unconditional Lean declarations whose only
project-specific axiom is that precisely cited external result.
-/

namespace QBinomialQuotientPositivityGapFour

open Polynomial

/-- The multiplicity with which `Φ_d` occurs in the product of the four
consecutive `q`-integers starting at `x`. -/
def multiplicity (x d : ℕ) : ℕ :=
  ((Finset.range 4).filter fun i ↦ d ∣ x + i).card

/-- The necessary and sufficient cyclotomic inequalities for the quotient
of the two four-term products to be a polynomial. -/
def CyclotomicCondition (a b : ℕ) : Prop :=
  ∀ d, 2 ≤ d → multiplicity b d ≤ multiplicity a d

/-- The fixed four-element index type used for numerator degrees and
denominator weights. -/
abbrev Index := Fin 4

def weight (b : ℕ) (j : Index) : ℕ := b + j

def degree (a : ℕ) (i : Index) : ℕ := a + i

/-- The additive semigroup generated by the weights indexed by `J`. -/
def weightSemigroup (b : ℕ) (J : Finset Index) : AddSubmonoid ℕ :=
  AddSubmonoid.closure (weight b '' (J : Set Index))

def Represented (a b : ℕ) (J : Finset Index) (i : Index) : Prop :=
  degree a i ∈ weightSemigroup b J

noncomputable def representedIndices (a b : ℕ) (J : Finset Index) : Finset Index :=
  letI := Classical.decPred (Represented a b J)
  Finset.univ.filter fun i ↦ Represented a b J i

/-- The Hall condition for the four denominator weights. -/
def HallCondition (a b : ℕ) : Prop :=
  ∀ J : Finset Index, J.Nonempty →
    J.card ≤ (representedIndices a b J).card

/-- The product `∏_{i=0}^3 (X^(x+i)-1)`. Four sign changes identify this
with the numerator or denominator product in equation (1). -/
noncomputable def fourProduct (R : Type*) [CommRing R] (x : ℕ) : Polynomial R :=
  ∏ i ∈ Finset.range 4, (Polynomial.X ^ (x + i) - 1)

noncomputable def IsPolynomialQuotient (a b : ℕ) : Prop :=
  fourProduct ℤ b ∣ fourProduct ℤ a

/-- Exact coefficient-positivity conclusion: the quotient is the image of
a polynomial with natural-number coefficients. -/
noncomputable def HasNonnegativeQuotient (a b : ℕ) : Prop :=
  ∃ Q : Polynomial ℕ,
    fourProduct ℤ a =
      fourProduct ℤ b * Q.map (Nat.castRingHom ℤ)

/-- The literal `q`-integer `[m]_q = 1 + q + ⋯ + q^(m-1)`.

This definition and the direct quotient interface below are adapted from the
Aristotle-generated companion formalization supplied with this project. -/
noncomputable def qInteger (m : ℕ) : Polynomial ℤ :=
  ∑ i ∈ Finset.range m, Polynomial.X ^ i

/-- The four consecutive `q`-integer factors beginning at `x`. -/
noncomputable def qIntegerProduct (x : ℕ) : Polynomial ℤ :=
  ∏ i ∈ Finset.range 4, qInteger (x + i)

/-- Polynomiality stated directly for the quotient occurring in the paper. -/
noncomputable def IsQIntegerPolynomialQuotient (a b : ℕ) : Prop :=
  qIntegerProduct b ∣ qIntegerProduct a

/-- Coefficientwise nonnegativity for the literal `q`-integer quotient. -/
noncomputable def HasNonnegativeQIntegerQuotient (a b : ℕ) : Prop :=
  ∃ Q : Polynomial ℕ,
    qIntegerProduct a =
      qIntegerProduct b * Q.map (Nat.castRingHom ℤ)

/-- Replace every integer coefficient by its natural-number representative.
When all coefficients are nonnegative, mapping this polynomial back to
`ℤ[X]` recovers the original polynomial. -/
noncomputable def coefficientwiseToNat (P : Polynomial ℤ) : Polynomial ℕ :=
  ⟨P.toFinsupp.mapRange Int.toNat (by simp)⟩

theorem coefficientwiseToNat_map_of_nonnegative
    (P : Polynomial ℤ) (hP : ∀ n, 0 ≤ P.coeff n) :
    (coefficientwiseToNat P).map (Nat.castRingHom ℤ) = P := by
  classical
  ext n
  rw [coeff_map]
  change ((P.coeff n).toNat : ℤ) = P.coeff n
  exact Int.natCast_toNat_eq_self.mpr (hP n)

lemma weight_mem_semigroup {b : ℕ} {J : Finset Index} {j : Index}
    (hj : j ∈ J) :
    weight b j ∈ weightSemigroup b J := by
  apply AddSubmonoid.subset_closure
  exact ⟨j, hj, rfl⟩

lemma multiple_weight_mem_semigroup
    {b n : ℕ} {J : Finset Index} {j : Index}
    (hj : j ∈ J) (hdiv : weight b j ∣ n) :
    n ∈ weightSemigroup b J := by
  obtain ⟨c, rfl⟩ := hdiv
  simpa [nsmul_eq_mul, Nat.mul_comm] using
    (weightSemigroup b J).nsmul_mem (weight_mem_semigroup hj) c

lemma X_pow_sub_one_ne_zero
    {R : Type*} [CommRing R] [Nontrivial R] {m : ℕ} (hm : 0 < m) :
    (Polynomial.X ^ m - 1 : Polynomial R) ≠ 0 := by
  intro h
  have hdeg :
      (Polynomial.X ^ m - 1 : Polynomial R).natDegree = m := by
    simpa using Polynomial.natDegree_X_pow_sub_C
      (R := R) (n := m) (r := (1 : R))
  rw [h, Polynomial.natDegree_zero] at hdeg
  omega

/-- The standard geometric-series identity for the literal `q`-integer. -/
lemma qInteger_mul_X_sub_one (m : ℕ) :
    qInteger m * (Polynomial.X - 1) = Polynomial.X ^ m - 1 := by
  simpa [qInteger] using (geom_sum_mul Polynomial.X m)

/-- Coefficients of a `q`-integer. Ported from the Aristotle formalization. -/
theorem qInteger_coeff (m k : ℕ) :
    (qInteger m).coeff k = if k < m then 1 else 0 := by
  simp only [qInteger, finsetSum_coeff, coeff_X_pow]
  by_cases h : k < m
  · rw [Finset.sum_eq_single k]
    · simp [h]
    · intro i _ hik
      simp [Ne.symm hik]
    · intro hk
      exact absurd (Finset.mem_range.mpr h) hk
  · simp only [if_neg h]
    apply Finset.sum_eq_zero
    intro i hi
    rw [Finset.mem_range] at hi
    rw [if_neg]
    omega

/-- Degree of a positive `q`-integer. Ported from the Aristotle
formalization. -/
theorem qInteger_natDegree (m : ℕ) (hm : 1 ≤ m) :
    (qInteger m).natDegree = m - 1 := by
  induction m with
  | zero => omega
  | succ n ih =>
    rcases Nat.eq_zero_or_pos n with hn | hn
    · subst hn
      simp [qInteger]
    · have hstep : qInteger (n + 1) = qInteger n + X ^ n := by
        simp [qInteger, Finset.sum_range_succ]
      rw [hstep]
      have hdeg :
          (qInteger n).natDegree < (X ^ n : Polynomial ℤ).natDegree := by
        rw [ih hn, natDegree_X_pow]
        omega
      rw [natDegree_add_eq_right_of_natDegree_lt hdeg, natDegree_X_pow]
      omega

theorem qInteger_ne_zero (m : ℕ) (hm : 1 ≤ m) :
    qInteger m ≠ 0 := by
  intro h
  have hc : (qInteger m).coeff (m - 1) = 1 := by
    rw [qInteger_coeff]
    simp
    omega
  rw [h] at hc
  simp at hc

/-- The degree of the paper's four-factor numerator or denominator block. -/
theorem qIntegerProduct_natDegree (x : ℕ) (hx : 1 ≤ x) :
    (qIntegerProduct x).natDegree = 4 * x + 2 := by
  rw [qIntegerProduct,
    natDegree_prod _ _ (fun i _ => qInteger_ne_zero _ (by omega))]
  rw [Finset.sum_range_succ, Finset.sum_range_succ,
    Finset.sum_range_succ, Finset.sum_range_one]
  rw [qInteger_natDegree _ (by omega), qInteger_natDegree _ (by omega),
    qInteger_natDegree _ (by omega), qInteger_natDegree _ (by omega)]
  omega

theorem qIntegerProduct_ne_zero (x : ℕ) (hx : 1 ≤ x) :
    qIntegerProduct x ≠ 0 := by
  rw [qIntegerProduct, Finset.prod_ne_zero_iff]
  intro i hi
  apply qInteger_ne_zero
  have hi := Finset.mem_range.mp hi
  omega

/-- Cancelling the four common `(X - 1)` factors identifies the literal
`q`-integer product with the product used for the cyclotomic argument. -/
lemma fourProduct_eq_qIntegerProduct_mul (x : ℕ) :
    fourProduct ℤ x =
      qIntegerProduct x * (Polynomial.X - 1) ^ 4 := by
  rw [fourProduct, qIntegerProduct]
  calc
    ∏ i ∈ Finset.range 4, (Polynomial.X ^ (x + i) - 1 : Polynomial ℤ) =
        ∏ i ∈ Finset.range 4,
          (qInteger (x + i) * (Polynomial.X - 1)) := by
            apply Finset.prod_congr rfl
            intro i hi
            exact (qInteger_mul_X_sub_one (x + i)).symm
    _ = (∏ i ∈ Finset.range 4, qInteger (x + i)) *
          ∏ _i ∈ Finset.range 4, (Polynomial.X - 1 : Polynomial ℤ) := by
            simp only [Finset.prod_mul_distrib]
    _ = qIntegerProduct x * (Polynomial.X - 1) ^ 4 := by
          simp [qIntegerProduct]

lemma X_sub_one_pow_four_ne_zero :
    ((Polynomial.X - 1) ^ 4 : Polynomial ℤ) ≠ 0 := by
  apply pow_ne_zero
  simpa using
    (X_pow_sub_one_ne_zero (R := ℤ) (m := 1) (by omega))

/-- Polynomiality for the paper's literal `q`-integer quotient is exactly
polynomiality for the four `(X^m - 1)` factors. -/
theorem isQIntegerPolynomialQuotient_iff (a b : ℕ) :
    IsQIntegerPolynomialQuotient a b ↔ IsPolynomialQuotient a b := by
  rw [IsQIntegerPolynomialQuotient, IsPolynomialQuotient]
  constructor
  · rintro ⟨P, hP⟩
    refine ⟨P, ?_⟩
    rw [fourProduct_eq_qIntegerProduct_mul,
      fourProduct_eq_qIntegerProduct_mul, hP]
    ac_rfl
  · rintro ⟨P, hP⟩
    refine ⟨P, ?_⟩
    rw [fourProduct_eq_qIntegerProduct_mul,
      fourProduct_eq_qIntegerProduct_mul] at hP
    apply mul_right_cancel₀ X_sub_one_pow_four_ne_zero
    simpa only [mul_assoc, mul_left_comm, mul_comm] using hP

/-- The two exact natural-coefficient formulations of positivity agree. -/
theorem hasNonnegativeQIntegerQuotient_iff (a b : ℕ) :
    HasNonnegativeQIntegerQuotient a b ↔ HasNonnegativeQuotient a b := by
  rw [HasNonnegativeQIntegerQuotient, HasNonnegativeQuotient]
  constructor
  · rintro ⟨Q, hQ⟩
    refine ⟨Q, ?_⟩
    rw [fourProduct_eq_qIntegerProduct_mul,
      fourProduct_eq_qIntegerProduct_mul, hQ]
    ac_rfl
  · rintro ⟨Q, hQ⟩
    refine ⟨Q, ?_⟩
    rw [fourProduct_eq_qIntegerProduct_mul,
      fourProduct_eq_qIntegerProduct_mul] at hQ
    apply mul_right_cancel₀ X_sub_one_pow_four_ne_zero
    simpa only [mul_assoc, mul_left_comm, mul_comm] using hQ

lemma rootMultiplicity_X_pow_sub_one_of_primitive
    {ζ : ℂ} {d m : ℕ} (hd : 2 ≤ d) (hm : 0 < m)
    (hζ : IsPrimitiveRoot ζ d) :
    Polynomial.rootMultiplicity ζ
      (Polynomial.X ^ m - 1 : Polynomial ℂ) =
        if d ∣ m then 1 else 0 := by
  have hp : (Polynomial.X ^ m - 1 : Polynomial ℂ) ≠ 0 :=
    X_pow_sub_one_ne_zero hm
  by_cases hdm : d ∣ m
  · have hroot : (Polynomial.X ^ m - 1 : Polynomial ℂ).IsRoot ζ := by
      rw [Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_X_pow,
        Polynomial.eval_one, (hζ.pow_eq_one_iff_dvd m).mpr hdm, sub_self]
    have hderiv :
        ¬(Polynomial.X ^ m - 1 : Polynomial ℂ).derivative.IsRoot ζ := by
      rw [Polynomial.IsRoot, Polynomial.derivative_sub,
        Polynomial.derivative_X_pow]
      simp only [Polynomial.derivative_one, sub_zero, Polynomial.eval_C_mul,
        Polynomial.eval_X_pow]
      exact mul_ne_zero (Nat.cast_ne_zero.mpr hm.ne')
        (pow_ne_zero _ (hζ.ne_zero (by omega)))
    have hnot :
        ¬1 < Polynomial.rootMultiplicity ζ
          (Polynomial.X ^ m - 1 : Polynomial ℂ) := by
      rw [Polynomial.one_lt_rootMultiplicity_iff_isRoot hp]
      exact fun h ↦ hderiv h.2
    have hpos :
        0 < Polynomial.rootMultiplicity ζ
          (Polynomial.X ^ m - 1 : Polynomial ℂ) :=
      (Polynomial.rootMultiplicity_pos hp).2 hroot
    simp [hdm]
    omega
  · have hnroot : ¬(Polynomial.X ^ m - 1 : Polynomial ℂ).IsRoot ζ := by
      rw [Polynomial.IsRoot, Polynomial.eval_sub, Polynomial.eval_X_pow,
        Polynomial.eval_one, sub_eq_zero]
      exact fun h ↦ hdm ((hζ.pow_eq_one_iff_dvd m).mp h)
    rw [Polynomial.rootMultiplicity_eq_zero hnroot, if_neg hdm]

lemma fourProduct_ne_zero
    {R : Type*} [CommRing R] [IsDomain R] {x : ℕ} (hx : 1 ≤ x) :
    fourProduct R x ≠ 0 := by
  rw [fourProduct, Finset.prod_ne_zero_iff]
  intro i hi
  apply X_pow_sub_one_ne_zero
  have hi := Finset.mem_range.mp hi
  omega

lemma rootMultiplicity_finset_prod
    {ζ : ℂ} {ι : Type*} [DecidableEq ι]
    (s : Finset ι) (f : ι → Polynomial ℂ)
    (hf : ∀ i ∈ s, f i ≠ 0) :
    Polynomial.rootMultiplicity ζ (∏ i ∈ s, f i) =
      ∑ i ∈ s, Polynomial.rootMultiplicity ζ (f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      have hfi : f i ≠ 0 := hf i (by simp)
      have hfs : ∏ j ∈ s, f j ≠ 0 := by
        rw [Finset.prod_ne_zero_iff]
        intro j hj
        exact hf j (by simp [hj])
      rw [Finset.prod_insert hi, Finset.sum_insert hi,
        Polynomial.rootMultiplicity_mul (mul_ne_zero hfi hfs)]
      congr
      exact ih (fun j hj ↦ hf j (by simp [hj]))

lemma rootMultiplicity_fourProduct
    {ζ : ℂ} {x d : ℕ} (hx : 1 ≤ x) (hd : 2 ≤ d)
    (hζ : IsPrimitiveRoot ζ d) :
    Polynomial.rootMultiplicity ζ (fourProduct ℂ x) =
      multiplicity x d := by
  rw [fourProduct,
    rootMultiplicity_finset_prod (Finset.range 4)
      (fun i ↦ (Polynomial.X ^ (x + i) - 1 : Polynomial ℂ))]
  · rw [multiplicity, Finset.card_filter]
    apply Finset.sum_congr rfl
    intro i hi
    rw [rootMultiplicity_X_pow_sub_one_of_primitive hd
      (Nat.add_pos_left (by omega) i) hζ]
  · intro i hi
    exact X_pow_sub_one_ne_zero (by omega)

lemma fourProduct_map
    {R S : Type*} [CommRing R] [CommRing S]
    (f : R →+* S) (x : ℕ) :
    (fourProduct R x).map f = fourProduct S x := by
  simp [fourProduct, Polynomial.map_prod]

/-- Section 1's cyclotomic consequence, proved through multiplicities at a
primitive complex root. -/
theorem cyclotomicCondition_of_polynomialQuotient
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hpoly : IsPolynomialQuotient a b) :
    CyclotomicCondition a b := by
  intro d hd
  let ζ := Complex.exp (2 * (Real.pi : ℂ) * Complex.I / d)
  have hζ : IsPrimitiveRoot ζ d := by
    dsimp [ζ]
    exact Complex.isPrimitiveRoot_exp d (by omega)
  have hdivC : fourProduct ℂ b ∣ fourProduct ℂ a := by
    have hmap := Polynomial.map_dvd (Int.castRingHom ℂ) hpoly
    simpa [fourProduct_map] using hmap
  have hmul :=
    Polynomial.rootMultiplicity_le_rootMultiplicity_of_dvd
      (fourProduct_ne_zero (R := ℂ) ha) hdivC ζ
  simpa [rootMultiplicity_fourProduct hb hd hζ,
    rootMultiplicity_fourProduct ha hd hζ] using hmul

lemma exists_numerator_multiple
    {a b d j : ℕ} (hcyclo : CyclotomicCondition a b)
    (hd : 2 ≤ d) (hj : j < 4) (hdiv : d ∣ b + j) :
    ∃ i < 4, d ∣ a + i := by
  have hbpos : 0 < multiplicity b d := by
    rw [multiplicity, Finset.card_pos]
    exact ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hj, hdiv⟩⟩
  have hapos : 0 < multiplicity a d :=
    lt_of_lt_of_le hbpos (hcyclo d hd)
  rw [multiplicity, Finset.card_pos] at hapos
  obtain ⟨i, hi⟩ := hapos
  simp only [Finset.mem_filter, Finset.mem_range] at hi
  exact ⟨i, hi.1, hi.2⟩

/-- The four denominator weights each divide a member of the numerator
block.  This is the only consequence of the cyclotomic inequalities used by
the gap lemma. -/
lemma denominator_weights_are_covered
    {a b : ℕ} (hb : 5 ≤ b) (hcyclo : CyclotomicCondition a b) :
    ∀ j < 4, ∃ x : ℕ, a ≤ x * (b + j) ∧ x * (b + j) ≤ a + 3 := by
  intro j hj
  obtain ⟨i, hi, hdiv⟩ :=
    exists_numerator_multiple hcyclo (by omega : 2 ≤ b + j) hj
      (dvd_refl (b + j))
  obtain ⟨x, hx⟩ := hdiv
  refine ⟨x, ?_, ?_⟩
  · rw [Nat.mul_comm, ← hx]
    omega
  · rw [Nat.mul_comm, ← hx]
    omega

/-- Section 3's singleton condition, including the exceptional weight `1`
which is not covered by the `d ≥ 2` cyclotomic convention. -/
theorem singleton_weight_is_covered
    {a b j : ℕ} (hb : 1 ≤ b) (hj : j < 4)
    (hcyclo : CyclotomicCondition a b) :
    ∃ i < 4, b + j ∣ a + i := by
  by_cases h : b + j = 1
  · exact ⟨0, by omega, by simp [h]⟩
  · exact exists_numerator_multiple hcyclo (by omega) hj (dvd_refl (b + j))

/-- The degree comparison from Section 1, derived directly from coverage of
the largest denominator weight. -/
theorem cyclotomic_implies_a_ge_b
    {a b : ℕ} (ha : 1 ≤ a) (hb : 1 ≤ b)
    (hcyclo : CyclotomicCondition a b) :
    b ≤ a := by
  obtain ⟨i, hi, hdiv⟩ :=
    exists_numerator_multiple hcyclo (d := b + 3) (j := 3)
      (by omega) (by omega) (by simp)
  obtain ⟨c, hc⟩ := hdiv
  by_contra h
  have hcpos : 1 ≤ c := by
    by_contra hc0
    have : c = 0 := by omega
    simp [this] at hc
    omega
  nlinarith

/-- The eight-case arithmetic heart of the gap lemma. -/
private lemma gap_core
    {a b x₀ x₁ x₂ x₃ : ℕ}
    (ha : 1 ≤ a) (hb : 5 ≤ b) (haT : a ≤ b * (b + 3) - 2)
    (h₀l : a ≤ x₀ * b)       (h₀u : x₀ * b ≤ a + 3)
    (h₁l : a ≤ x₁ * (b + 1)) (h₁u : x₁ * (b + 1) ≤ a + 3)
    (h₂l : a ≤ x₂ * (b + 2)) (h₂u : x₂ * (b + 2) ≤ a + 3)
    (h₃l : a ≤ x₃ * (b + 3)) (h₃u : x₃ * (b + 3) ≤ a + 3) :
    a = b := by
  have hx₀ : 1 ≤ x₀ := by
    by_contra h
    have : x₀ = 0 := by omega
    simp [this] at h₀l
    omega
  have hx₁ : 1 ≤ x₁ := by
    by_contra h
    have : x₁ = 0 := by omega
    simp [this] at h₁l
    omega
  have hx₂ : 1 ≤ x₂ := by
    by_contra h
    have : x₂ = 0 := by omega
    simp [this] at h₂l
    omega
  have hx₃ : 1 ≤ x₃ := by
    by_contra h
    have : x₃ = 0 := by omega
    simp [this] at h₃l
    omega

  have hTpos : 2 ≤ b * (b + 3) := by nlinarith
  have haT' : a + 2 ≤ b * (b + 3) := by omega

  have hx₁_le : x₁ ≤ b + 1 := by
    by_contra h
    have hmul : (b + 2) * (b + 1) ≤ x₁ * (b + 1) :=
      Nat.mul_le_mul_right (b + 1) (by omega)
    nlinarith only [hmul, h₁u, haT']
  have hx₂_le : x₂ ≤ b := by
    by_contra h
    have hmul : (b + 1) * (b + 2) ≤ x₂ * (b + 2) :=
      Nat.mul_le_mul_right (b + 2) (by omega)
    nlinarith only [hmul, h₂u, haT']
  have hx₃_le : x₃ ≤ b := by
    by_contra h
    have hmul : (b + 1) * (b + 3) ≤ x₃ * (b + 3) :=
      Nat.mul_le_mul_right (b + 3) (by omega)
    nlinarith only [hmul, h₃u, haT']

  have h₀₁ : x₁ ≤ x₀ := by
    by_contra h
    have hmul : (x₀ + 1) * (b + 1) ≤ x₁ * (b + 1) :=
      Nat.mul_le_mul_right (b + 1) (by omega)
    nlinarith only [hmul, h₀l, h₁u, hb, hx₀]
  have h₁₂ : x₂ ≤ x₁ := by
    by_contra h
    have hmul : (x₁ + 1) * (b + 2) ≤ x₂ * (b + 2) :=
      Nat.mul_le_mul_right (b + 2) (by omega)
    nlinarith only [hmul, h₁l, h₂u, hb, hx₁]
  have h₂₃ : x₃ ≤ x₂ := by
    by_contra h
    have hmul : (x₂ + 1) * (b + 3) ≤ x₃ * (b + 3) :=
      Nat.mul_le_mul_right (b + 3) (by omega)
    nlinarith only [hmul, h₂l, h₃u, hb, hx₂]

  have h₀₁' : x₀ ≤ x₁ + 1 := by
    by_contra h
    have hmul : (x₁ + 2) * b ≤ x₀ * b :=
      Nat.mul_le_mul_right b (by omega)
    nlinarith only [hmul, h₁l, h₀u, hx₁_le, hb]
  have h₁₂' : x₁ ≤ x₂ + 1 := by
    by_contra h
    have hmul : (x₂ + 2) * (b + 1) ≤ x₁ * (b + 1) :=
      Nat.mul_le_mul_right (b + 1) (by omega)
    nlinarith only [hmul, h₂l, h₁u, hx₂_le, hb]
  have h₂₃' : x₂ ≤ x₃ + 1 := by
    by_contra h
    have hmul : (x₃ + 2) * (b + 2) ≤ x₂ * (b + 2) :=
      Nat.mul_le_mul_right (b + 2) (by omega)
    nlinarith only [hmul, h₃l, h₂u, hx₃_le, hb]

  rcases (by omega : x₀ = x₁ ∨ x₀ = x₁ + 1) with h₀ | h₀ <;>
    rcases (by omega : x₁ = x₂ ∨ x₁ = x₂ + 1) with h₁ | h₁ <;>
      rcases (by omega : x₂ = x₃ ∨ x₂ = x₃ + 1) with h₂ | h₂
  · -- 000
    subst x₀
    subst x₁
    subst x₂
    nlinarith only [h₀l, h₃u, hx₃]
  · -- 001
    subst x₀
    subst x₁
    subst x₂
    nlinarith only [h₀l, h₂u, hx₃]
  · -- 010
    subst x₀
    subst x₁
    subst x₂
    nlinarith only [h₀l, h₁u, h₂l, hb, hx₃]
  · -- 011
    subst x₀
    subst x₁
    subst x₂
    nlinarith only [h₀l, h₁u, h₂l, hb, hx₃]
  · -- 100
    subst x₀
    subst x₁
    subst x₂
    nlinarith only [h₁l, h₃u, h₀u, hb, hx₃]
  · -- 101
    subst x₀
    subst x₁
    subst x₂
    nlinarith only [h₁l, h₂u, h₃l, hb, hx₃]
  · -- 110
    subst x₀
    subst x₁
    subst x₂
    nlinarith only [h₂l, h₃u, h₀u, hb, hx₃]
  · -- 111
    subst x₀
    subst x₁
    subst x₂
    have hxb : b ≤ x₃ := by
      by_contra h
      have hstep : x₃ + 1 ≤ b := by omega
      nlinarith only [h₃l, h₁u, hstep]
    have : x₃ = b := by omega
    subst x₃
    nlinarith only [h₁u, haT']

/-- The sharp index-gap-four gap lemma for `b ≥ 5`. -/
theorem gap_lemma
    {a b : ℕ} (ha : 1 ≤ a) (hb : 5 ≤ b)
    (hcyclo : CyclotomicCondition a b) :
    a = b ∨ b * (b + 3) - 1 ≤ a := by
  by_cases hlarge : b * (b + 3) - 1 ≤ a
  · exact Or.inr hlarge
  · left
    have haT : a ≤ b * (b + 3) - 2 := by omega
    have hcov := denominator_weights_are_covered hb hcyclo
    obtain ⟨x₀, h₀l, h₀u⟩ := hcov 0 (by omega)
    obtain ⟨x₁, h₁l, h₁u⟩ := hcov 1 (by omega)
    obtain ⟨x₂, h₂l, h₂u⟩ := hcov 2 (by omega)
    obtain ⟨x₃, h₃l, h₃u⟩ := hcov 3 (by omega)
    norm_num at h₀l h₀u h₁l h₁u h₂l h₂u h₃l h₃u
    exact gap_core ha hb haT h₀l h₀u h₁l h₁u h₂l h₂u h₃l h₃u

/-- Membership in the additive semigroup generated by two natural numbers. -/
def TwoGenerated (x y n : ℕ) : Prop :=
  ∃ r s : ℕ, n = r * x + s * y

def ThreeGenerated (x y z n : ℕ) : Prop :=
  ∃ r s t : ℕ, n = r * x + s * y + t * z

lemma TwoGenerated.toThreeGenerated {x y z n : ℕ}
    (h : TwoGenerated x y n) :
    ThreeGenerated x y z n := by
  obtain ⟨r, s, hrs⟩ := h
  exact ⟨r, s, 0, by simpa using hrs⟩

lemma TwoGenerated.toThreeGeneratedOuter {x y z n : ℕ}
    (h : TwoGenerated x z n) :
    ThreeGenerated x y z n := by
  obtain ⟨r, t, hrt⟩ := h
  exact ⟨r, 0, t, by simpa using hrt⟩

lemma TwoGenerated.toThreeGeneratedLast {x y z n : ℕ}
    (h : TwoGenerated y z n) :
    ThreeGenerated x y z n := by
  obtain ⟨s, t, hst⟩ := h
  exact ⟨0, s, t, by simpa using hst⟩

/-- The two-generator Frobenius assertion used in Section 3, in its coprime
form. -/
theorem coprime_frobenius_bound
    {x y n : ℕ} (hcop : x.Coprime y) (hx : 1 < x) (hy : 1 < y)
    (hn : x * y - x - y < n) :
    TwoGenerated x y n := by
  have hF := (frobeniusNumber_iff.mp (frobeniusNumber_pair hcop hx hy)).2 n hn
  rw [AddSubmonoid.mem_closure_pair] at hF
  obtain ⟨r, s, hrs⟩ := hF
  exact ⟨r, s, by simpa [nsmul_eq_mul, Nat.mul_comm] using hrs.symm⟩

